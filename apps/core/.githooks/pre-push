#!/usr/bin/env sh
# Pre-push quality gate — this repo's ONLY test gate.
#
# There is no cloud CI: pushes from the workstation are what trigger Argo's
# build/deploy, so the tests belong in front of the push rather than after it.
#
# Runs: docs manifest -> quadlet units -> lint -> format -> typecheck -> unit tests -> integration tests (needs Postgres) -> build.
#
# Escape hatches (use deliberately, they push untested code):
#   SKIP_TESTS=1 git push        skip the whole gate
#   SKIP_INTEGRATION=1 git push  skip only the DB-backed integration tests
set -e

if [ "${SKIP_TESTS:-0}" = "1" ]; then
  echo "⚠ pre-push: gate SKIPPED explicitly (SKIP_TESTS=1)"
  exit 0
fi

# Branch/tag deletions push no content — nothing to test. stdin gives one line
# per ref: "<local_ref> <local_sha> <remote_ref> <remote_sha>"; an all-zero
# local_sha means "delete this remote ref".
has_content=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    '' | *[!0]*) has_content=1 ;;
  esac
done
if [ "$has_content" = "0" ]; then
  echo "▶ pre-push: deletion-only push, no tests to run"
  exit 0
fi

# ── FIRST TIER: the documentation manifest ──────────────────────────────────
# No network, no node, no install: POSIX shell over the README's `##
# Documentation` table and the `docs/` directory. It is first because it is the
# cheapest, and because openplate.de reads that table as its manifest — a broken
# row here fails a workflow in another repository, hours later, with nobody
# watching. M193 spec 05.
echo "▶ pre-push: the README Documentation table against docs/"
./scripts/check-docs-manifest.sh

# ── QUADLET UNITS: generated, never hand-edited ─────────────────────────────
# docker/quadlet/<scenario>/ is what podlet writes from the compose files.
# This regenerates every scenario into a temp dir and diffs it against the
# committed copy, so a compose edit without `scripts/quadlet.sh generate`, or a
# unit somebody touched by hand, stops here. podlet is a HOST tool (Homebrew),
# not a toolbox one, like the browser tier; the script says how to install it.
# M231 spec 02.
echo "▶ pre-push: the quadlet units against a fresh podlet run"
./scripts/quadlet.sh check

# Where the TS commands run. Inside a container they run bare. Where a toolbox
# exists they run in the ts-dev toolbox, as they always have: the maintainer's
# host lacks native build tools. Anywhere else they run with the node and pnpm
# on PATH, so a contributor needs only Node, pnpm and make to push (M269 spec
# 08). .githooks/test-no-toolbox.sh at the repository root proves that path.
if [ -f /run/.containerenv ] || [ -f /.dockerenv ]; then
  run() { CI=true "$@"; }
elif command -v toolbox >/dev/null 2>&1; then
  run() { toolbox run -c ts-dev env CI=true "$@"; }
else
  for tool in node pnpm; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "✖ pre-push: $tool is not on PATH. The gate needs Node 24 or newer and pnpm 11."
      exit 1
    fi
  done
  run() { CI=true "$@"; }
fi

echo "▶ pre-push: lint"
run pnpm lint

# Prettier drifted across 44 files while this hook ran lint but not format:check
# (found 2026-09-24, M253/04). The check costs seconds, so it guards every push.
echo "▶ pre-push: format"
run pnpm format:check

echo "▶ pre-push: typecheck"
run pnpm typecheck

echo "▶ pre-push: unit tests"
run pnpm test:unit

# tests/integration/db-harness.ts defaults to the shared local Postgres on
# localhost:5433 (override with TEST_DATABASE_URL). Unreachable Postgres fails
# the push rather than silently downgrading the gate to unit-only.
#
# The probe is node, not nc: node is on every machine that can run this gate,
# nc is not, and a probe that is skipped when nc is missing let the suite fail
# later with a connection error that names no fix. It runs through `run`, so it
# reads the same TEST_DATABASE_URL the suite reads, and inside the toolbox (which
# passes no variable through) it falls back to the same default. The default
# below is a copy of the harness's DEFAULT_TEST_DATABASE_URL; keep the two equal.
db_probe='
  const url = new URL(process.env.TEST_DATABASE_URL ?? "postgres://postgres:postgres@localhost:5433/openplate_sync_test");
  const port = Number(url.port || 5432);
  process.stdout.write(`${url.hostname}:${port}`);
  const socket = require("node:net").connect(port, url.hostname);
  socket.setTimeout(3000);
  socket.on("connect", () => process.exit(0));
  socket.on("error", () => process.exit(1));
  socket.on("timeout", () => process.exit(1));
'

if [ "${SKIP_INTEGRATION:-0}" = "1" ]; then
  echo "⚠ pre-push: integration tests SKIPPED explicitly (SKIP_INTEGRATION=1)"
elif ! db_at=$(run node -e "$db_probe"); then
  echo "✖ pre-push: no Postgres on ${db_at:-localhost:5433}, and integration is a REQUIRED gate."
  echo "  Start one in apps/core with: docker compose -f docker/compose.dev.yml up -d"
  echo "  (it serves the default TEST_DATABASE_URL), or set TEST_DATABASE_URL to another Postgres."
  echo "  Bypass once with: SKIP_INTEGRATION=1 git push"
  exit 1
else
  echo "▶ pre-push: integration tests (postgres on $db_at)"
  run pnpm test:integration
fi

echo "▶ pre-push: build"
run pnpm build

echo "✅ pre-push: all gates passed"
