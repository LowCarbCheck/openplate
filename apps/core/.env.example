# openplate-core configuration.
#
# Copy to `.env` and edit. Everything marked REQUIRED must be set or the
# service refuses to start, deliberately. A core server that boots with a
# weak secret and starts taking accounts is a much worse outcome than one that
# will not boot.
#
# The parser lives in `src/config.ts`; keep the two in step.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Rarely needed, and read directly rather than through the config parser:
#   MIGRATIONS_DIR=drizzle/migrations   # where the migrator looks (src/main.ts)
#   SERVICE_VERSION=                    # overrides the version GET /health reports

# Postgres connection string. Required when you run the service directly with
# node or pnpm. Under `docker compose` it is IGNORED: the container builds its
# own connection string from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB
# below, so editing this line has no effect on a compose install.
DATABASE_URL=postgres://openplate:openplate@localhost:5432/openplate_sync

# Root secret, at least 32 characters. Generate one and never rotate it
# casually:
#
#   openssl rand -hex 32
#
# Three domain-separated subkeys are derived from it
# (`src/lib/server-secrets.ts`): the pepper mixed into every stored auth
# verifier, the key behind the deterministic dummy KDF descriptors served for
# unknown addresses, and the AES key that seals each account's escrowed
# recovery code.
#
# CHANGING IT INVALIDATES EVERY EXISTING LOGIN AND EVERY ESCROWED RECOVERY
# CODE, AND THERE IS NO WAY BACK. Treat it like a database password and back it
# up WITH the database: a restored database with a lost secret is a database
# nobody can log into and no reset can rescue.
SERVER_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

PORT=3000
LOG_LEVEL=info

# Which address the listener binds to. LEAVE IT UNSET IN PRODUCTION: unset
# binds every interface, which is what this container needs behind Traefik,
# and it is what every deployment has always done.
#
# SET IT ON A DEVELOPMENT MACHINE. A dev instance binds every interface too,
# so a seeded database, an ADMIN_TOKEN and the whole /v1/admin tree become
# reachable from every other machine on your network. 127.0.0.1 keeps it on
# the laptop; a tailnet address (for example 100.64.0.3) keeps it on the
# tailnet. Any IPv4 address, IPv6 address or resolvable name works, and an
# address this box does not own fails at boot with EADDRNOTAVAIL.
#
# Empty is the same as unset. Inside a container, leave it empty: the
# published port reaches only a listener on every interface. On a laptop,
# write HOST=127.0.0.1.
HOST=

# What this instance calls itself. Today the name appears in two places: the
# /health handshake (`instance.name`) and the start-up log line. The letters
# this service sends say "openplate" and do not use it. At most 64 characters.
INSTANCE_NAME=openplate

# Which language the letters this service sends are written in: `en`, `de`,
# `fr`, `it`, `es` or `tr`. Anything else is a boot failure rather than a
# silent fall back to English on the day somebody needs their own. A sign-up
# request or a declaration that names the reader's language gets its letter in
# that one instead.
INSTANCE_LANGUAGE=en

# Which body's micronutrient reference values this instance shows: `dge` (the
# German DGE, the default), `efsa` (the EU) or `us` (NASEM). Anything else is a
# boot failure: the three name three different sets of numbers a person is
# shown beside their food.
#
# THIS ONE IS ONLY THE DEFAULT, unlike every other variable in this file. An
# administrator changes the live setting without a redeploy, with
# `pnpm core-api settings set nutrient-reference-basis efsa`, and the stored
# row wins from then on. This value is what a fresh instance starts on, and
# what the service falls back to if it cannot read that row.
NUTRIENT_REFERENCE_BASIS=dge

# The version of the health-data consent wording every account must agree to,
# such as `2026-09-28`: 1 to 32 letters, digits, `.`, `_` or `-`. Anything else
# is a boot failure. /health publishes it as `instance.healthConsent`.
#
# LEAVE IT EMPTY IF YOU ARE YOUR OWN OPERATOR, which is what self-hosting
# means: an instance that holds only its operator's diary has nobody to ask.
# SET IT IF YOU RUN AN INSTANCE FOR OTHER PEOPLE and your privacy notice names
# explicit consent (Art. 9(2)(a) GDPR) as the legal basis for their diary.
# Then a new account cannot be created without it (POST /v1/auth/signup
# answers `400 health-consent-required`), and the app asks every existing
# account once. The version and the instant are stored on the account, and
# you can read both in the admin account view.
#
# CHANGING IT ASKS EVERYBODY AGAIN. Change it when the wording changes.
HEALTH_CONSENT_VERSION=

# This service's own public base URL, and where your openplate client lives.
# Both are optional and both are needed together: they build the link in an
# invitation and in a password-reset mail
# (`https://<client>/join#server=<this>&invite=…`). With neither, the admin API
# returns the raw token instead and you paste it yourself.
#
# An absolute http(s) URL, or a boot failure. A misspelled one is discovered by
# the person you invited, not by you.
#
# With mail on in production, both must be https:// addresses other people
# can open. Otherwise the service refuses to boot. The image sets
# NODE_ENV=production. A mailed link is opened on somebody else's phone,
# where `localhost` or `127.0.0.1` opens nothing and a plain http:// address
# cannot sign anyone in. The docker compose files fill these two from
# PUBLIC_APP_URL and PUBLIC_SYNC_URL and fall back to localhost, so set those
# in their .env. Without mail, or outside production, nothing is checked. You
# copy each link yourself, and the app's admin screen tells you when a link
# opens another address than the one you are using.
SERVER_PUBLIC_URL=
CLIENT_BASE_URL=

# Number of reverse proxies in front of this service (`1` behind a single
# nginx/Traefik), or `true`/`false`.
#
# GET THIS RIGHT. Left at `false` behind a proxy, `req.ip` is the proxy's
# address and the per-IP throttle becomes ONE global bucket that a single
# attacker can lock for every user. Set to `true` with no proxy in front and
# anyone can spoof `X-Forwarded-For` to escape the throttle entirely.
TRUST_PROXY=false

# Enable only if your Postgres requires TLS.
DATABASE_SSL=false

# ── Notice to your users (optional) ─────────────────────────────────────────
# A short message every connecting client shows as a dismissible banner. This
# is the ONLY thing resembling a contact channel this service has, and it is
# PULL, not push: the client reads it from GET /health when it connects, so it
# reaches the people who open the app and nobody else, and the server never
# learns who read it. Changing it is a redeploy.
#
# Under Docker Compose, `docker/compose.yml` forwards both of these, so the
# value you put here reaches the container. If you run your own Compose file,
# name them in its `environment:` block: Compose passes only the variables that
# block names, so a variable set here and nowhere else changes nothing.
#
# If you need to be able to REACH your users, keep that contact list yourself,
# outside this service. See README.md.
#
# At most 280 characters, and a longer value is a BOOT FAILURE rather than a
# silently truncated sentence: /health is also this container's healthcheck
# path and is polled continuously, so the length is capped on purpose.
SYNC_NOTICE=

# Optional link shown beside the notice. Absolute https:// (or http://) only ,
# any other scheme is a boot failure, and setting it without SYNC_NOTICE is too.
SYNC_NOTICE_URL=

# ── Admin API (optional, off by default) ────────────────────────────────────
# Enables `/v1/admin` and the `pnpm core-api` CLI over it: account metadata,
# aggregate storage counts, and account erasure (the DSAR mechanism).
#
# LEAVE IT UNSET UNLESS YOU WANT THE FEATURE. Unset, the whole `/v1/admin`
# tree answers the same 404 any unknown path does, an instance without this
# variable is indistinguishable from one built before the feature existed.
# That is deliberate: a 401 would advertise that a credential exists here and
# is merely locked.
#
# Generate it, do not choose it: `openssl rand -hex 32`. Minimum 24
# characters. It can list every account and delete any of them; it can never
# read a blob, a verifier or a KDF descriptor, see
# docs/adr/0001-an-admin-api-for-a-zero-knowledge-service.md.
ADMIN_TOKEN=

# ── Billing credential (optional, off by default) ───────────────────────────
# The credential a BILLING service holds. It is not ADMIN_TOKEN and it is not
# a second copy of it: it reaches three routes and two fields, and every other
# route under /v1/admin answers 403 to it.
#
# What it can do:
#   GET   /v1/admin/accounts/expiring   ids and end dates, for reconciliation
#   GET   /v1/admin/accounts/:id        that one account's id, end date and
#                                       daily AI limit, and nothing else
#   PATCH /v1/admin/accounts/:id        only allowanceExpiresAt and
#                                       dailyAiLimit; any other key is a 403
#
# What it cannot do: list the accounts on this instance, read anybody's
# address or name, suspend, change a role, erase, mint or resend an invitation,
# or open a reported photograph.
#
# LEAVE IT UNSET UNLESS A BILLING SERVICE REACHES THIS INSTANCE. With this and
# ADMIN_TOKEN both unset, the whole /v1/admin tree answers the same 404 any
# unknown path does, exactly as before this variable existed.
#
# Generate it, do not choose it: `openssl rand -hex 32`. Minimum 24
# characters, the same floor ADMIN_TOKEN has: what it moves is what somebody
# paid for. It must differ from ADMIN_TOKEN, or the service refuses to boot:
# the admin door checks ADMIN_TOKEN first, so an equal value would give the
# biller the whole admin API.
BILLING_TOKEN=
#
# The largest daily AI limit that BILLING_TOKEN may write on an account,
# default 1000. The biller can also never clear an allowance's end date. Your
# own ADMIN_TOKEN has neither bound (its ceiling is 10000). Keep it at or above
# the largest plan you sell.
# BILLING_MAX_DAILY_AI_LIMIT=1000

# ── The biller behind /v1/plans (optional, off by default) ──────────────────
# Where this gateway forwards /v1/plans/* , and the shared secret it presents
# there. BOTH OR NEITHER: a URL with no secret refuses to boot, because the
# secret is the only thing that tells the biller the account id it is reading
# came from a gateway that authenticated somebody.
#
# LEAVE THEM UNSET UNLESS A BILLING SERVICE STANDS BEHIND THIS INSTANCE. Unset,
# the whole /v1/plans subtree answers the same 404 any unknown path does, to
# everybody, and /health reports "plans": false. A self-hoster who never
# configured a biller cannot tell this build has one.
#
# THE CALLER'S OWN ACCESS TOKEN IS NEVER FORWARDED. The biller receives exactly
# three headers it can trust, X-Account-Id from the session, X-Account-Email
# from the account row, and X-Plans-Secret holding the value below, plus the
# request's Content-Type. Nothing else the client sent travels, which is what
# stops the biller from becoming a second place a stolen token works.
#
# PLANS_UPSTREAM_URL is the base of the biller's INTERNAL surface, reached over
# the container network and never over a public host, for example
# http://openplate-billing:3000/plans . Everything after /v1/plans in an
# inbound request is appended to it.
# PLANS_UPSTREAM_SECRET is compared by the biller before it trusts either
# account header. Generate it, do not choose it: `openssl rand -hex 32`.
# PLANS_UPSTREAM_URL=
# PLANS_UPSTREAM_SECRET=

# ── Web push (optional, off by default) ─────────────────────────────────────
# The VAPID credentials this service signs push messages with. ALL THREE OR
# NONE: two of the three refuses to boot, because a half-configured block is an
# operator who believes their users are getting a morning catch-up and has no
# way to find out they are not.
#
# LEAVE THEM UNSET UNLESS THIS INSTANCE SHOULD SEND NOTIFICATIONS. Unset, the
# whole /v1/push subtree answers the same 404 any unknown path does, to
# everybody, and /health reports "push": false.
#
# WHAT A PUSH CONTAINS IS A KIND AND NOTHING ELSE, for example
# {"kind":"catch-up"}. This server writes no notification text: the device
# wakes, reads the diary only it can read, and writes the words. See
# docs/adr/0008-push-is-a-scheduling-exception.md.
#
# Generate a pair once, with `pnpm core-api push keygen`, and keep the private
# key in a vault. VAPID_SUBJECT is how a push service reaches the operator when
# something is wrong: a mailto: address or an https URL, and RFC 8292 requires
# one.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.org
#
# A device may only register an endpoint that is https, on the default port,
# at a push service a browser uses: fcm.googleapis.com (Chrome and every other
# Chromium browser but Edge), *.push.services.mozilla.com (Firefox),
# *.push.apple.com (Safari) and *.notify.windows.com (Edge). Anything else is
# refused, so a signed-in caller cannot make this server POST to an internal
# address. Only if you run your own push service, add its host here, comma
# separated; *.example.org covers every host under example.org.
# PUSH_ENDPOINT_HOSTS=

# ── Diary sharing (optional, off by default) ────────────────────────────────
# Enables the clinician-sharing endpoint family: a patient wraps their data
# key to a clinician's PUBLIC key, and the clinician reads the patient's blob
# through a share row. The server's position does not change, it holds one
# more blob it has no key for, and it never stores, generates or endorses a
# share public key.
#
# LEAVE IT UNSET UNLESS YOU WANT THE FEATURE. Unset, both `/v1/sync/shares`
# and `/v1/sync/shared` answer the same 404 any unknown path does, to
# everybody, with or without a valid token, same bargain ADMIN_TOKEN makes,
# and for the same reason.
#
# Accepts true/false or 1/0. See
# docs/adr/0002-sharing-a-diary-without-giving-the-server-a-key.md, including
# what revocation can and cannot do: it controls the future, and it cannot
# repossess what a clinician already downloaded.
SYNC_SHARING=false

# ── Research contributions (optional, off by default) ───────────────────────
# Enables the study-contribution endpoint family: a contributor pushes a
# REDUCED, day-granular slice of their diary, not the diary, sealed to a
# study's PUBLIC key, under a pseudonym their own device derives from a secret
# this server never holds. The server's position does not change: it holds
# more sealed bytes it has no key for, and it never stores, generates or
# endorses a study public key.
#
# READ THIS BEFORE TURNING IT ON. A contribution is PSEUDONYMOUS, never
# anonymous: longitudinal daily nutrition totals are a behavioural
# fingerprint, and anyone holding a cohort plus any auxiliary dataset can
# re-identify a series. Enabling this makes your server hold a study graph ,
# which account contributes to which study, which is health-adjacent personal
# data (PROTOCOL.md §9.2). Each study carries its own ethics approval; this
# software does not supply one.
#
# LEAVE IT UNSET UNLESS YOU WANT THE FEATURE. Unset, both
# `/v1/sync/contributions` and `/v1/sync/study` answer the same 404 any
# unknown path does, to everybody, with or without a valid token.
#
# INDEPENDENT OF SYNC_SHARING, neither flag implies the other.
#
# Accepts true/false or 1/0. See
# docs/adr/0003-research-contributions-pseudonymous-but-never-anonymous.md.
SYNC_RESEARCH=false

# ── Reported estimates (optional, off by default) ───────────────────────────
# Enables POST /v1/feedback: a person who sees a wrong measurement on an entry
# can send that entry's figures and its PHOTOGRAPH to you, after agreeing to it
# in plain words on their device. What is stored is the photograph, the
# figures, and the record of what they agreed to and when. Nothing else: no
# diary content, no food name beyond what the reported entry carries, no IP and
# no device identifier.
#
# WHAT THIS COSTS YOU, PLAINLY: with this on, you hold photographs of your
# users' food, in your own database, and you can look at them. That is a real
# change to what this service is, not a bigger version of what it already does.
# Every other write path here stores something nobody can read: ciphertext, a
# digest, a counter, a sealed envelope. This one does not. It is the SECOND
# place the zero-knowledge position does not hold, and it is not the same shape
# as the first: the AI proxy SEES a photograph and keeps nothing, this KEEPS
# what it is given, for thirty days. If you run an instance for other
# people, that is a promise you are now making to them, and it belongs in
# whatever you told them about this server.
#
# THIRTY DAYS IS NOT A SETTING, deliberately. The service deletes a report and
# its photograph thirty days after it arrives, on its own, on a timer inside the
# process, and there is no variable here to change that. The number is the one
# the app shows a person in the consent step, and an operator who could raise it
# would be extending a promise somebody else made. You can always delete a
# report sooner, in the console or with DELETE /v1/admin/feedback/<id>.
#
# WITH THIS ON, /health SAYS SO. The handshake gains one field,
# instance.feedback.retentionDays, carrying the same number the sweep deletes
# on. That is what lets the app state the window in its consent step instead of
# printing a number of its own, which would be a promise you never made. With
# this unset the field is ABSENT, not null: the handshake is byte-identical to
# an instance built before the feature existed, the same bargain the 404 makes,
# and an app that finds no window offers no report at all. It is one number on
# a path your healthcheck polls forever, which is why it is one number.
#
# YOU CAN LOOK AT THE PHOTOGRAPHS, AND EVERY LOOK IS LOGGED. The reports are at
# /v1/admin/feedback behind your admin credential, and every read of an image
# writes one line to this service's log naming who opened which report and when.
# That line is for you as much as for your users: it is what turns "the operator
# can see everything" into something anybody can check afterwards.
#
# LEAVE IT UNSET UNLESS YOU WANT THE FEATURE. Unset, the whole /v1/feedback
# subtree answers the same 404 any unknown path does, to everybody, with or
# without a valid token, same bargain ADMIN_TOKEN, SYNC_SHARING and
# SYNC_RESEARCH make, and for the same reason.
#
# INDEPENDENT OF EVERY OTHER FLAG. Nothing implies it and it implies nothing.
#
# Accepts true/false or 1/0. Read
# docs/adr/0006-a-reported-photograph-is-the-second-hole-in-the-claim.md before
# you turn it on.
SYNC_FEEDBACK=false

# How many reports one account may store per UTC day. Five is a bound on abuse,
# not on usefulness: a person reports the entry in front of them once, and this
# is what stops a compromised client filling your disk overnight.
# FEEDBACK_DAILY_LIMIT=5

# The largest report body this route accepts, in bytes. 8 MB by default, which
# is a camera JPEG after base64 inflates it by 4/3. The decoded image itself is
# capped at 5 MB, which is why this number sits above that one: a body limit AT
# the image cap would reject a legal maximum-size report before the handler saw
# it.
#
# THIS IS NOT AI_MAX_REQUEST_BYTES. That one bounds a photograph this service
# forwards; this one bounds a photograph it keeps.
# FEEDBACK_MAX_REQUEST_BYTES=8000000

# ── Removed variables ───────────────────────────────────────────────────────
#
# THE SERVICE REFUSES TO START IF ANY OF THESE IS SET. They are rejected rather
# than ignored: a variable that is quietly ignored lets you believe a door is
# shut when it is open, or that mail is configured under a name this service
# does not read.
#
#   SIGNUP_MODE   SIGNUPS_OPEN   REQUIRE_EMAIL_VERIFICATION   EMAIL_FROM
#   SMTP_SECURE   PIGEON_API_KEY   PIGEON_BASE_URL
#
# SMTP_HOST, SMTP_PORT, SMTP_USER, and SMTP_PASSWORD were on this list until
# SMTP returned as a mail transport. The server reads them again. See Mail
# below.
#
# SIGNUP IS INVITE-ONLY, ALWAYS. There is no open mode and no closed mode:
# an account is created by redeeming an invite you addressed to somebody, and
# there is no other door. Mint one with:
#
#   pnpm core-api invites create --email anna@example.org --name "Anna"
#
# The link (or the raw token, if you configured no CLIENT_BASE_URL) prints
# once and is not stored; only its digest is kept.
#
# An account is an EMAIL ADDRESS plus a passphrase, and the invitation is what
# verifies the address: the person who received the letter is the person who
# redeems it, so there is no second confirmation link.
#
# WHAT THIS COSTS YOU, PLAINLY: the client no longer shows a recovery code, and
# this service holds each account's code in escrow, sealed under a subkey of
# SERVER_SECRET. That is what makes "forgot password" work and restore the
# diary rather than merely the login. It also means YOU, as the operator, hold
# what it takes to open an account. Read
# docs/adr/0005-organization-accounts-and-escrowed-recovery.md before you run
# this for anybody but yourself.

# ── Mail ────────────────────────────────────────────────────────────────────
# ONE TRANSPORT OR NONE: an HTTP mail API, or SMTP. Setting both fails at
# startup. A partial configuration also fails: a service with a URL but no key
# would report invitations as sent and deliver nothing.
#
# With one transport set, this service sends the invitation and password reset
# letters, plus (M214/09) a receipt for every cancellation or withdrawal
# filed through /kuendigung or /widerruf in the app. It also sends a copy to
# MAIL_OPERATOR_EMAIL. Without one, account letters return to you as links to
# copy. A declaration is still recorded, but it is mailed to nobody. Nothing is
# silently dropped either way.
#
# SMTP_SECURE and PIGEON_* fail startup. They are not fallbacks.

# Use any Resend-compatible mail API. The service POSTs JSON to MAIL_API_URL
# with MAIL_API_KEY as a Bearer token. Set all three.
# MAIL_API_URL=https://api.resend.com/emails
# MAIL_API_KEY=
# MAIL_API_FROM=openplate <noreply@example.org>
#
# With our own mail service Pigeon, MAIL_API_URL ends in /v1/emails (for example
# http://pigeon:3601/v1/emails). Two things then happen that a Resend URL does
# not get. Letters that carry a link (invitation, password reset, sign-up link)
# ask Pigeon to keep no copy of the body after the send (retain_body: false).
# And deleting an account sends POST /v1/recipients/erase to the same base with
# the address in the body, so Pigeon forgets it. That call never blocks a delete.
# It is tried three times, and a failure is logged without the address. Nothing
# stores the address to try again later: Pigeon's retention limit is the backstop.

# Or SMTP. SMTP_HOST and SMTP_FROM are required. SMTP_PORT is 587 when unset.
# The port decides the encryption. Port 465 is TLS from the first byte. Every
# other port must upgrade with STARTTLS. A server that does not offer it gets
# nothing. Only a host on this machine (localhost, 127.0.0.0/8, ::1), such as
# a local Mailpit, may take plain text. Certificates are always checked.
# SMTP_USER and SMTP_PASSWORD go together. Leave both unset for a server that
# takes no login. For Gmail, turn on 2-Step Verification and use an app
# password on smtp.gmail.com, port 587.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=openplate <you@gmail.com>

# An SMTP server whose certificate comes from your own certificate authority
# fails the check above. Give Node that authority instead: a PEM file, read
# once at start. Node reads this variable itself, not src/config.ts, so it
# takes effect on the next restart. Under docker compose, mount the file into
# the container (the commented volume line in the compose files) and write its
# container path here. There is no switch that turns the check off.
# NODE_EXTRA_CA_CERTS=/etc/openplate/ca.pem

# Where a cancellation or a withdrawal is mailed, on top of the person who
# filed it. This is the ONE address on this service that reads as "the
# operator" rather than "a user": §312k BGB and §356a BGB both require an
# immediate acknowledgement, and this is how you learn one arrived without
# watching the database.
# MAIL_OPERATOR_EMAIL=you@example.org

# The words of those two declaration letters (M246/04). A folder, mounted
# read-only, holding <lang>/mail/declaration-receipt-<kind>.md and
# <lang>/mail/declaration-alert-<kind>.md: the same variable, and it can be the
# same folder, the openplate app reads its legal pages from. Unset, or a file
# missing or refused, and the letter carries only the facts: the kind, the
# receipt number, the time of receipt and every field the person gave. It is
# never checked at boot, and an edited file shows on the next letter.
# docs/operations/declaration-mail-text.md has the file format and the exact
# fallback text.
# CONTENT_DIR=/srv/openplate/content

# The two daily ceilings on declaration receipts (M270/11). The form needs no
# sign-in and mails a receipt to whatever address was typed, from your sending
# domain, so these keep it from becoming a way to mail strangers. Past either
# one a declaration is still stored, forwarded and sent to MAIL_OPERATOR_EMAIL;
# only its receipt is skipped, the response does not change, and the log says
# which ceiling it was. Both count over the trailing 24 hours. The first is
# for the whole instance, read from the stored declarations. The second is per
# sender network (an IPv4 address or an IPv6 /64), kept in memory, so a restart
# resets it. One mailbox also gets at most three receipts a day, which is not
# a setting. Zero is a boot failure, not "off".
# LEGAL_DECLARATION_RECEIPTS_PER_DAY=200
# LEGAL_DECLARATION_RECEIPTS_PER_NETWORK_PER_DAY=10

# ── The AI proxy ────────────────────────────────────────────────────────────
# BOTH OR NEITHER. With them set, a signed-in account posts an ordinary
# OpenAI-compatible request to POST /v1/chat/completions with its OWN access
# token; this service spends one unit of that account's daily allowance,
# replaces the token with the key below, and streams the answer back. The
# account never learns your key.
#
# Leave UPSTREAM_API_KEY unset and the route DOES NOT EXIST: it answers the
# ordinary unknown-path 404, and /health reports instance.ai: null so the app
# knows not to offer a scan.
#
# WHAT THIS COSTS YOU, PLAINLY: a food photograph and the model's answer cross
# this process. Neither is written, cached or logged, the log line carries an
# account id, an upstream status, byte counts and a duration. This is one of the
# two places where this service's zero-knowledge claim does not hold, because
# the proxy can see what the blob store cannot. The other is SYNC_FEEDBACK
# above, and it is not the same shape: this route sees a photograph and keeps
# nothing, that one keeps what it is given.

# UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
# UPSTREAM_API_KEY=

# TWO OPTIONAL ROUTING SETTINGS, FOR AN OPENROUTER UPSTREAM ONLY. Unset, the
# default, the proxy sends what it always sent: provider.data_collection =
# "deny", which asks OpenRouter to route only to endpoints that do not store or
# train on a request. That is a routing request, not a guarantee. These two ask
# for more. On any other host they do nothing: no provider field is sent there.
#
# UPSTREAM_ZDR=true adds provider.zdr = true: only endpoints with zero data
# retention. Only "true" turns it on; "false" and empty are off, and any other
# spelling stops the boot rather than quietly meaning off.
#
# UPSTREAM_PROVIDER_ONLY is a comma separated list of provider slugs, for
# example google-vertex. It adds provider.only = [the slugs] and
# provider.allow_fallbacks = false: the request goes to one of those providers
# or fails, and never falls back to another. A slug is lowercase, an empty entry
# or a name with a space stops the boot. Check the slug against the model's page
# on OpenRouter: a pin the model does not offer makes every scan fail.
#
# The caller can set neither: a provider field in its own body is replaced.
# UPSTREAM_ZDR=
# UPSTREAM_PROVIDER_ONLY=

# THE MODEL EVERY REQUEST GOES TO. /health reports it so the app can name it,
# and the proxy writes it into every forwarded body, for every account, so a
# caller cannot pick a dearer model on your key. Leave it unset and the model is
# whatever the client asks for, which a self-hosted instance may want.
# AI_ADVERTISED_MODEL=

# The most output tokens one request may ask for, default 8192. A larger
# max_tokens is capped, a missing one is written in, with or without a model
# above. The proxy also sets n to 1, forwards only the fields on its allow list
# (messages, stream, stream_options, temperature, top_p, response_format, the
# output caps, reasoning, n, model) and drops every other one, logging its name.
# It never refuses a request for them. See PROTOCOL.md section 5.19.
# AI_MAX_OUTPUT_TOKENS=8192

# What one request may carry IN. A request with more image parts, more bytes of
# text (message text plus response_format) or more messages is refused with
# 400 ai-request-too-large before anything is counted. The defaults are the
# app's largest real request: one photograph, two messages, about 12 KB of text.
# AI_MAX_IMAGE_PARTS=1
# AI_MAX_TEXT_BYTES=49152
# AI_MAX_MESSAGES=4

# What one request WEIGHS on the daily allowance and the instance ceilings:
# max(1, ceil(estimated input tokens / AI_UNIT_INPUT_TOKENS)), where the
# estimate is text bytes / 4 plus AI_IMAGE_INPUT_TOKENS per image. A plate scan
# weighs 1; a request near the text bound weighs 2.
# AI_UNIT_INPUT_TOKENS=8192
# AI_IMAGE_INPUT_TOKENS=1500

# The daily allowance is PER ACCOUNT and lives in the database, not here. It
# defaults to 0 on a new invite, so minting an ordinary invitation does not
# hand out your provider key by accident:
#
#   pnpm core-api invites create --email anna@example.org --daily-limit 200
#   pnpm core-api accounts set-limit 42 200
#
# These three are the bounds that are the same for everybody. The per-minute one
# catches a stuck client that retries on every error and would otherwise spend
# a whole day's allowance in ten seconds.
# AI_RATE_LIMIT_PER_MINUTE=20
# UPSTREAM_TIMEOUT_MS=120000

# THE ONLY BOUND HERE THAT IS NOT PER ACCOUNT: the whole instance's ceiling, in
# requests per UTC day, across everybody together. Unset, the default, means
# there is none.
#
# Set it if people can invite each other. The daily allowance and the
# per-minute limiter both count one account at a time, so ten accounts at 200
# requests a day is 2000 requests a day charged to the key above. Invitations
# multiply accounts; they do not multiply the bound.
#
# With the ceiling reached, every account is refused with 503 until the next
# UTC midnight, including somebody who has spent none of their own allowance.
# GET /v1/admin/stats reports the ceiling beside the count of what has been
# spent today, so read the two together.
#
# ZERO IS NOT ACCEPTED and the service will not boot with it. It reads like
# "no ceiling" and does the opposite: it refuses every request while a provider
# key is still configured, which looks exactly like the provider being down.
# Unset this line for no ceiling, or unset UPSTREAM_API_KEY for no AI at all.
# AI_INSTANCE_DAILY_LIMIT=1500

# THE LOW-BUDGET ALERT, for an OpenRouter key only (UPSTREAM_BASE_URL on
# openrouter.ai). The service reads the key's limit and what is left of it
# every 15 minutes, and GET /v1/admin/ai/budget shows the same numbers in the
# console. When less than this share of the limit is left, MAIL_OPERATOR_EMAIL
# gets one mail per reset period of the key; a restart does not send it again.
# Without mail configured it is a warning in the log instead. Above 0 and
# below 1; unset means 0.2.
# AI_BUDGET_ALERT_FRACTION=0.2

# The largest completion request the proxy accepts, in bytes. 8 MB by default,
# which is a camera JPEG of about 5.7 MiB after base64 inflates it by 4/3.
#
# THIS IS NOT THE BLOB LIMIT. That one bounds a diary this service stores; this
# one bounds a photograph it only forwards. Raise it if your users' phones send
# larger originals and you see 413s; every 413 from this route names this
# variable in its message so the person reading a screenshot knows which knob
# to turn.
# AI_MAX_REQUEST_BYTES=8000000

# ── Member invites (M212) ───────────────────────────────────────────────────
# Whether an ordinary member may invite people, and on what terms. BOTH LINES
# OR NEITHER: half of the pair is a boot failure naming the one you left out.
# Unset, the default, means members cannot invite anybody and
# POST /v1/auth/invites answers 404 to everybody, exactly as if the feature had
# never been written. You then mint every invitation yourself with
# POST /v1/admin/invites.
#
# THE TERMS ARE YOURS, NOT THE INVITER'S. A member sends an address and nothing
# else: they cannot choose the allowance, the role or the lifetime, and they are
# never told whether the address they typed already has an account here.
#
# EACH MEMBER MAY SEND FIVE INVITATIONS IN TOTAL, ever, unless you say
# otherwise with MEMBER_INVITE_LIFETIME_CAP below. Withdrawing one does not give
# it back: the count is the letters an account caused, not the ones that worked.
# Administrators are exempt from the cap.
#
# READ THESE WITH AI_INSTANCE_DAILY_LIMIT ABOVE. The daily allowance below is
# charged to your provider key once per invited person per day, so it is
# multiplied by every member on the instance times the cap. Set the ceiling
# before you set these.
#
# MEMBER_INVITE_DAILY_AI_LIMIT is the invited account's AI requests per UTC day.
# MEMBER_INVITE_ALLOWANCE_DAYS is how many days after they sign up that
# allowance lasts. After it, the AI proxy answers 403 and their diary keeps
# working: sync is never gated on an allowance.
# MEMBER_INVITE_DAILY_AI_LIMIT=50
# MEMBER_INVITE_ALLOWANCE_DAYS=30
#
# MEMBER_INVITE_LIFETIME_CAP is optional and defaults to 5. It is an integer of
# 0 or more, and 0 keeps the route mounted with nothing for anyone to spend.
# Set it to 2 if you pay for the provider key yourself and want the instance to
# grow slowly. Setting it while the two lines above are unset is a boot failure:
# there is no door for it to narrow.
# MEMBER_INVITE_LIFETIME_CAP=5

# ── Open sign-up (optional) ─────────────────────────────────────────────────
# Lets anybody ask this instance for an account with their own address, at
# POST /v1/auth/signup-request. Unset, which is the default, keeps the instance
# invite-only: the route answers the ordinary unknown-path 404 and /health says
# openSignup: false.
#
# IT IS STILL AN INVITATION. The request mints an ordinary addressed invite and
# MAILS it to that address, so the letter is the address check. That is why
# OPEN_SIGNUP=true without the mail block above is a boot failure. The answer is
# the same 202 for a new address, one that already has an account (it gets a
# short note with no link) and one that already holds a letter from you or a
# member (it gets nothing new).
#
# THE BOUNDS: five requests per source address per hour, one letter per mailbox
# per day (dots and +tags count as one mailbox), and addresses at known
# throwaway mail services are refused. The two counters live in memory, so a
# restart forgets them. Read AI_INSTANCE_DAILY_LIMIT above before you open the
# door on an instance that grants AI.
#
# The only accepted value is `true`. Anything else, `false` included, is a boot
# failure that says so.
# OPEN_SIGNUP=true
#
# A Cloudflare Turnstile captcha on that door, both or neither, and only beside
# OPEN_SIGNUP=true. The site key is published on /health so the app can render
# the widget; the secret key never leaves this service. Unset runs the door
# without a captcha, and the service logs that at boot.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# ── Free AI scans for new accounts (optional) ───────────────────────────────
# A new account gets TRIAL_SCANS free AI scans, at TRIAL_DAILY_AI_LIMIT
# requests per UTC day, and with TRIAL_DAYS for that many days at most. After the last one the AI proxy
# answers 403 trial-scans-spent and the diary keeps working. A scan is one AI
# action the person started: the app sends one X-Intake-Id per action, a retry
# of that action costs nothing more, and an attempt that got no answer (a
# provider error or timeout) gives its scan back. A future allowance date, which
# a payment writes, lifts the count.
#
# BOTH OR NEITHER. TRIAL_SCANS is 1 to 100, TRIAL_DAILY_AI_LIMIT at least 1.
# /health then promises the number as instance.trial.
#
# TRIAL_DAYS, optional and only beside the pair, is 1 to 90: the trial also
# ends at midnight after that many days, whichever comes first. The day the
# account is created does not count, so 14 days from a sign-up on the 29th end
# at 00:00 on the 14th of the next month, at 10:00 or at 23:30 alike. The AI
# proxy then answers 403 trial-expired. /health promises it as
# instance.trial.days. Unset means no end date. The end is written on the
# account when it is created, so setting it later never shortens the trial of
# an account that already exists.
#
# TRIAL_TIME_ZONE, optional and only beside TRIAL_DAYS, is the IANA zone of
# that midnight, for example Europe/Berlin. Unset is UTC. An unknown name
# stops the boot. It moves the midnight, never the number of days.
#
# WHICH DOORS GRANT IT: open sign-up above, an invite you mint with
# `pnpm core-api invites create --trial`, and, with MEMBER_INVITE_TRIAL=true, a
# member's invitation. MEMBER_INVITE_TRIAL=true is a boot failure beside
# MEMBER_INVITE_DAILY_AI_LIMIT or MEMBER_INVITE_ALLOWANCE_DAYS: a member
# invitation grants the scans or the days, never both. For scans or days,
# whichever comes first, set TRIAL_DAYS instead.
#
# ONE MAILBOX, ONE TRIAL, EVER. A +tag and Gmail dots count as one mailbox. The
# rule needs TRIAL_ADDRESS_PEPPER, required beside the pair: invite rows carry a
# keyed hash of the mailbox (HMAC-SHA256 under this secret), and deleting an
# account scrubs the address from every invite row and keeps only that hash
# when the account held a trial. Generate it once with `openssl rand -hex 32`;
# changing it forgets every mailbox that already had its trial.
#
# AI_TRIAL_INSTANCE_DAILY_LIMIT, optional, is what all trial accounts together
# may spend per UTC day, below AI_INSTANCE_DAILY_LIMIT, so a burst of new
# trials cannot use up the capacity paying accounts need. They get the same
# 503 ai-instance-ceiling. Zero, or a value on an instance with no trial, is a
# boot failure.
#
# AI_TRIAL_NETWORK_DAILY_LIMIT, optional, is what the trial requests from ONE
# network (an IPv6 /64, or one IPv4 address) may spend of the trial ceiling
# per UTC day, so a few farmed accounts cannot use it up for everybody. Unset
# is a tenth of AI_TRIAL_INSTANCE_DAILY_LIMIT, rounded down, at least 1; it is
# off without that ceiling. A refusal is the same 503 ai-instance-ceiling.
# Everybody behind one IPv4 carrier NAT shares one bucket. The counter keeps a
# keyed hash of the network under TRIAL_ADDRESS_PEPPER, never the address.
# Zero, a value above the trial ceiling, or a value without it is a boot
# failure; equal to the ceiling turns the share off.
# TRIAL_SCANS=10
# TRIAL_DAILY_AI_LIMIT=50
# TRIAL_DAYS=14
# TRIAL_TIME_ZONE=Europe/Berlin
# TRIAL_ADDRESS_PEPPER=
# MEMBER_INVITE_TRIAL=true
# AI_TRIAL_INSTANCE_DAILY_LIMIT=1000
# AI_TRIAL_NETWORK_DAILY_LIMIT=100

# ── A standing free daily AI limit (optional) ───────────────────────────────
# DEFAULT_FREE_DAILY_AI_LIMIT is the number of AI requests per UTC day that
# every account gets when it has no free limit of its own: an account with
# its own limit (set with `pnpm core-api accounts set-free-limit <id> <n>`)
# keeps that number, and a live paid window still wins while it runs. The
# limit never ends and is never scan gated. A day used up answers
# 429 with Retry-After, never the 403 of an account with no AI at all.
# 0 or unset means off, and then nothing changes.
#
# It REPLACES the scan trial, so it cannot be set beside TRIAL_SCANS and
# TRIAL_DAILY_AI_LIMIT: the boot stops with a message naming both. An account
# that already carries a trial from before simply falls under this limit and
# spends no scan. 1 to 10000. The requests still count against
# AI_INSTANCE_DAILY_LIMIT.
# DEFAULT_FREE_DAILY_AI_LIMIT=3

# ── AI feature permissions (optional) ───────────────────────────────────────
# A capability is a short label, such as scan or recipes, for one kind of AI
# request. An account holds a list of them (written by an administrator, or by
# the billing service through its own credential), and the AI proxy refuses a
# request whose feature the account does not hold with 403 capability-required,
# before it counts anything.
#
# DEFAULT_CAPABILITIES is what an account with no list of its own may use:
# comma separated labels, each a lower case letter then up to 31 lower case
# letters, digits or hyphens. The word "none" means no capability at all.
# UNSET OR EMPTY MEANS NO CHECK: every request passes, which is what an
# instance had before this setting, and what a self-hosted instance wants.
# "none" is reserved and cannot be a label.
#
# A client names its feature with the X-Openplate-Feature request header. That
# is the client's word, so CAPABILITY_SCHEMA_MAP makes it enforceable: comma
# separated schemaName:label pairs. A request whose body asks for the
# structured output response_format.json_schema.name you list needs that label
# whatever its header says. A request that names no feature and no listed
# schema is not checked.
# DEFAULT_CAPABILITIES=scan
# CAPABILITY_SCHEMA_MAP=scan_result:scan,recipe_list:recipes

# ── Docker Compose only ─────────────────────────────────────────────────────
# Read by `docker/compose.yml` to provision the bundled Postgres.

POSTGRES_USER=openplate
POSTGRES_PASSWORD=openplate
POSTGRES_DB=openplate_sync
SYNC_PORT=3000

# ── Tests only ──────────────────────────────────────────────────────────────
# The integration suite targets the shared local Postgres, never the
# `docker/compose.yml` database above. Contributors without one can start
# `docker/compose.dev.yml`, which serves exactly the default URL below.
# Override if yours lives elsewhere.

# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/openplate_sync_test
