{
  "name": "openplate-core",
  "version": "0.33.0",
  "private": true,
  "type": "module",
  "description": "Standalone account server with encrypted diary sync for openplate. Bitwarden-model accounts over CAS blob push/pull and wrapped-DEK key records, on a versioned wire protocol (see PROTOCOL.md). Stores opaque ciphertext only; it cannot decrypt what it holds.",
  "license": "MIT",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "node --import tsx --watch src/main.ts",
    "build": "tsx scripts/build.ts",
    "core-api": "tsx scripts/sync-api/main.ts",
    "sync-api": "tsx scripts/sync-api/sync-api-alias.ts",
    "sync:translate-lib": "tsx scripts/sync-translate-lib.ts",
    "translate:mail": "tsx scripts/translate-mail.ts",
    "sync:disposable-domains": "tsx scripts/sync-disposable-domains.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "test:integration": "node --import tsx --test --test-concurrency=1 'tests/integration/**/*.test.ts'",
    "test:guard": "node --import tsx --test tests/integration/photo-path-guard.test.ts",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix --max-warnings 0",
    "format:check": "prettier --check \"**/*.{ts,md,json}\"",
    "drizzle:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "drizzle:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "drizzle:push": "tsx node_modules/drizzle-kit/bin.cjs push",
    "drizzle:studio": "tsx node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.3",
    "nodemailer": "10.0.10",
    "pg": "^8.16.3",
    "undici": "8.10.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.6",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "oxlint": "1.78.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
