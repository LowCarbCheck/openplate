{
  "name": "openrouter-pilot",
  "description": "Reproduces the 2026-08-11 cloud pilot: Gemini 3.1 Flash Lite single-shot, Qwen3-VL-8B single-shot, and Gemma-4-26B-A4B x5 diverse prompts + same-model judge merge. Costs real money (~$0.003/plate across all three approaches).",
  "images_dir": "images",
  "gold": "gold/gold_labels.json",
  "out_dir": "runs/openrouter-pilot-rerun",
  "providers": {
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "headers": {
        "HTTP-Referer": "https://sprqvntrs.com/openplate-bench",
        "X-Title": "openplate plate-id bench"
      },
      "timeout_seconds": 120,
      "max_retries": 3,
      "retry_backoff_base_seconds": 2.0
    }
  },
  "models": {
    "gemini_flash_lite": {
      "id": "google/gemini-3.1-flash-lite",
      "provider": "openrouter",
      "price_per_mtok_in": 0.25,
      "price_per_mtok_out": 1.5,
      "use_json_schema": true
    },
    "qwen3_vl_8b": {
      "id": "qwen/qwen3-vl-8b-instruct",
      "provider": "openrouter",
      "price_per_mtok_in": 0.117,
      "price_per_mtok_out": 0.455,
      "use_json_schema": true
    },
    "gemma4_26b_a4b": {
      "id": "google/gemma-4-26b-a4b-it",
      "provider": "openrouter",
      "price_per_mtok_in": 0.12,
      "price_per_mtok_out": 0.4,
      "use_json_schema": true
    }
  },
  "approach_order": ["baseline", "single_qwen8b", "ensemble_judge"],
  "approaches": {
    "baseline": {
      "type": "single",
      "model": "gemini_flash_lite",
      "label": "google/gemini-3.1-flash-lite single-shot (frontier reference row)"
    },
    "single_qwen8b": {
      "type": "single",
      "model": "qwen3_vl_8b",
      "label": "qwen/qwen3-vl-8b-instruct single-shot"
    },
    "ensemble_judge": {
      "type": "ensemble_judge",
      "vision_model": "gemma4_26b_a4b",
      "judge_model": "gemma4_26b_a4b",
      "variants": [
        "a_production",
        "b_production_hot",
        "c_detection",
        "d_taxonomy_first",
        "e_skeptic"
      ],
      "max_parallel": 5,
      "label": "gemma-4-26b-a4b x5 diverse prompts + judge merge"
    }
  }
}
