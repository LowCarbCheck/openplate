{
  "name": "openplate-inference",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Self-hostable, OpenAI-compatible plate-identification endpoint for openplate. Takes one plate photo, returns a PlateIdentification payload. Photos are processed in memory and never written to disk or logged.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "node --import tsx --watch src/main.ts",
    "food-data:fdc": "tsx scripts/food-data/build-fdc-dataset.ts",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix --max-warnings 0",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "sharp": "^0.34.4",
    "undici": "8.10.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.78.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "oxlint": "1.78.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
