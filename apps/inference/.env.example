# openplate-inference — operator-facing counterpart to src/config.ts.
# Every variable below is validated at boot; a bad value stops the process.

# ---------------------------------------------------------------------------
# Model runtime
# ---------------------------------------------------------------------------
#
# The service REQUIRES a runtime address and refuses to boot without one — but
# in the container the entrypoint supplies it, so there is nothing to set here
# unless you are bringing your own runtime or running outside Docker.

# Base address of the model runtime. No trailing /v1 — the service appends the
# OpenAI paths itself. Must be reachable from THIS container, not from the
# browser.
#
# RUNTIME SUPPORT — measured 2026-08-15, not inferred from API surface. This
# pipeline REQUIRES grammar-constrained decoding (response_format: json_schema);
# a runtime that cannot enforce it cannot serve this service.
#
#   llama.cpp (llama-server)  b10330    WORKS — schema enforced, /health reports
#                                       503 while loading and 200 when ready
#   Ollama                    0.32.13   WORKS — schema enforced. Note it has NO
#                                       /health endpoint, and /v1/models answers
#                                       200 even with no model resident, so
#                                       readiness against Ollama is liveness only
#   vLLM (CPU build)          0.27.1    BROKEN — a json_schema request kills the
#                                       server outright ("pin_memory=True
#                                       requires a CUDA or other accelerator
#                                       backend"). Plain completions work; the
#                                       first real scan takes the process down
#   vLLM (GPU build)          0.27.1    WORKS — schema enforced (xgrammar), image
#                                       accepted. Measured on an RTX 3090. Same
#                                       image as the CPU row above: the GPU is
#                                       the difference, not the version
#
# Other OpenAI-compatible runtimes are untested. Before trusting one, send a
# json_schema request with a prompt that demands prose: if the reply is still
# schema-shaped, the grammar is being enforced.
#
# LEAVE THIS COMMENTED unless you are bringing your own runtime.
#
# The container sets it for you: a bundled MODEL_PROFILE (lite | lite-apache |
# quality) starts llama-server on its own loopback and points the service there.
# Setting it to a DIFFERENT address AND running a bundled profile is refused at
# boot rather than silently ignored — see scripts/docker-entrypoint.sh. (The
# exact value below is the bundled address itself, so it is allowed and changes
# nothing; only a harmful override is refused.) To use your own runtime,
# uncomment this AND set MODEL_PROFILE=external, which skips the weight download
# and starts no llama-server. See README, "Bring your own runtime".
#
# Running the service outside the container (pnpm dev) is the other case where
# you set this yourself — there is no entrypoint to do it for you.
# MODEL_RUNTIME_URL=http://127.0.0.1:8080

# lite | lite-apache | quality | external. `external` means "no weights, no
# bundled runtime — use MODEL_RUNTIME_URL". Read by the container entrypoint,
# NOT by the service (the service sees PROFILE, below).
# MODEL_PROFILE=lite

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# Comma-separated bearer keys accepted on /v1/*. Leave unset and the service
# generates one at boot and prints it once — convenient for a first run, but it
# lives in memory only, so a restart invalidates it. Set this for anything real.
# API_KEYS=opk_replace_me,opk_second_client

# OPTIONAL bearer sent TO the model runtime, on the completion call and on both
# readiness probes. Leave unset for the bundled llama-server, which wants no
# auth. Set it when you bring your own runtime behind auth — e.g.
# `vllm serve --api-key …` or an auth proxy.
#
# Measured on vLLM: it answers 401 to every unauthenticated
# /v1/chat/completions while leaving /health OPEN, so without this key the
# service reports ready and then fails every scan. (An auth proxy typically
# authenticates /health too, which fails more honestly — /readyz just goes red.)
# MODEL_RUNTIME_API_KEY=sk_your_runtime_key

# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------

PORT=8300

# Model id sent TO the runtime. llama-server ignores it; vLLM requires an exact
# match with the served model name. The id CLIENTS use is always
# "openplate-plate-1" regardless of this value.
# MODEL_ID=openplate-plate-1

# In-flight requests. Match your runtime's slot count (llama-server --parallel N).
CONCURRENCY=2

# Waiting line in front of the pool. Past this, callers get 429 + Retry-After.
MAX_QUEUE_DEPTH=8

# Projected-latency ceiling in milliseconds. 0 = disabled, which is the
# SELF-HOST default: a CPU box legitimately takes 25-110 s per plate and
# shedding load at 10 s there would refuse everything it can serve. Set 10000
# on hosted hardware, where "p95 <= 10 s per scan" is a hard maximum and a slow
# success counts as a failure.
LATENCY_CEILING_MS=0

# Total bound on ONE completion call, in milliseconds. 0 disables it entirely.
# Default 600000 (10 minutes). Applies in BOTH modes — bundled and BYO.
# RUNTIME_COMPLETION_TIMEOUT_MS=600000
#
# THIS IS NOT LATENCY_CEILING_MS, and confusing the two will cost you a bad
# afternoon. LATENCY_CEILING_MS is ADMISSION POLICY: refuse work you cannot
# finish in time, before starting it. This is LIVENESS: release a worker slot an
# upstream is never going to return. At 600 s it is ~60x the hosted latency
# policy — a backstop, not a target, and it should never be the thing deciding
# how long a scan is allowed to take.
#
# Why it exists: Node's fetch applies a default headersTimeout of 300 s, and
# every runtime here buffers a non-streaming completion and writes headers only
# when generation finishes — so that default is a 300 s TOTAL cap nobody chose.
# The worst plate we have measured is 155.9 s (Qwen3-VL, 14 threads), and halving
# threads roughly doubles it, so an ordinary 8-core box lands near that cap.
# Setting this explicitly at 600000 LOOSENS the cap you are running today.
#
# Why not unbounded: with CONCURRENCY=2, two wedged in-flight scans hold both
# worker slots forever and the service stops serving while /readyz stays green —
# the readiness probes hit a different endpoint and cannot see it.
#
# A call that hits the bound fails with a message naming this variable. If your
# hardware legitimately needs longer per plate, raise it or set it to 0.

# Per-key requests per minute (token bucket, continuous refill).
RATE_LIMIT_RPM=60

# ---------------------------------------------------------------------------
# Image handling
# ---------------------------------------------------------------------------

# Maximum DECODED image size in bytes (8 MiB). The JSON body limit is derived
# from this automatically (base64 inflates by 4/3).
MAX_IMAGE_BYTES=8388608

# Long-edge downscale target in pixels. 896 is the benchmarked setting (72.8%
# recall, 0 hallucinations on the 50-image gold set) and a multiple of 112, an
# exact patch boundary for both LFM2.5-VL and Qwen3-VL. Raising it raises
# latency roughly with the square.
IMAGE_MAX_LONG_EDGE=896

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# lite | quality | custom. Informational for now; spec 05 (packaging) is what
# selects a model and serving flags from it.
PROFILE=custom

# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Nutrition resolution (spec 04)
# ---------------------------------------------------------------------------

# Which food corpus this service resolves identified items against.
#
# The vision model NEVER reports macros — it names foods and estimates grams,
# and this stage looks up what those foods are made of. So this setting decides
# whether a scan comes back with nutrition at all. An unresolved item is
# returned with `macrosPer100g: null`, never with a guessed number.
#
#   fdc   (default) The bundled USDA FoodData Central extract in
#         data/fdc-foods.json. Public domain, fully offline, no key, no
#         account, no outbound request to anyone. 8041 generic foods.
#   off   OpenFoodFacts, fetched live from world.openfoodfacts.org at YOUR
#         runtime. Strong on branded/packaged products, weak on generic cooked
#         food. OFF is ODbL 1.0 (share-alike) — enabling this is your choice and
#         the obligation is yours. Nothing OFF-derived ships in this image.
#   lcc   The lowcarbcheck public API. The best data available (curated + BLS +
#         USDA), and remote-only forever: BLS 4.0 prohibits redistribution, so
#         it cannot be bundled. Requires outbound network.
#   none  Skip resolution entirely. Every item comes back with null macros.
FOOD_SOURCE=fdc

# Path to the generated USDA extract, relative to the working directory.
# Regenerate with `pnpm food-data:fdc` (needs network + unzip). If this file is
# missing, the service logs a loud warning, DISABLES resolution, and keeps
# serving identifications — a missing food database is not a reason to stop
# reading plates.
# FDC_DATASET_PATH=./data/fdc-foods.json

# Base URL for FOOD_SOURCE=lcc. Ignored by every other backend.
# LCC_API_URL=https://lowcarbcheck.org

# OPTIONAL second model runtime serving OpenAI-compatible /v1/embeddings (e.g.
# `llama-server --embedding`). Set it and retrieval becomes hybrid: the lexical
# scorer finds candidates and the embedding model re-ranks them. Leave it unset
# — the default — and retrieval is lexical-only, which is a slightly worse
# ranking and never an error. An unreachable runtime degrades to lexical-only
# with one warning; it never fails a scan.
# EMBEDDING_RUNTIME_URL=http://127.0.0.1:8081

# OPTIONAL bearer for that embeddings runtime. Only read when
# EMBEDDING_RUNTIME_URL is set. A missing or wrong key does NOT fail a scan — it
# degrades retrieval to lexical-only, which /readyz reports as
# `embeddingReady: false` with a reason (the response stays 200: lexical-only is
# a legitimate mode, not an outage).
# EMBEDDING_RUNTIME_API_KEY=sk_your_embedding_key
