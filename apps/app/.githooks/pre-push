#!/usr/bin/env sh
# Pre-push quality gate, this repo's ONLY test gate (no cloud CI).
#
# Pushes to main auto-trigger the Argo build/deploy, so the gate belongs in
# front of the push. Added 2026-08-04 after a prod build failure (RR8
# split-route-modules choking on diary.tsx route chunks) sailed through
# typecheck + unit tests: neither runs `react-router build`, so the
# PRODUCTION BUILD is part of this gate.
#
# Runs: Chromium launch check -> docs manifest -> quadlet units -> changelog
#       -> lint -> typecheck -> unit tests + integration tests, with the
#       production build running beside them -> browser smoke tier (sharded).
#
# Stage order, in plain words:
#   * The Chromium launch check runs FIRST of all the stages. A host with no
#     working browser fails in seconds, not after the build and the tests.
#   * Lint and typecheck stay serial and run before everything slow.
#   * The production build starts in the BACKGROUND right after typecheck, and
#     the unit and integration tests run in front while it builds. Nothing in
#     tests/unit or tests/integration reads build/, so the two do not meet.
#     When the tests are done, the hook waits for the build. A failed build
#     prints its whole log and the hook exits with the build's exit code. A
#     good build prints the last lines of its log, so the output still shows
#     that it happened. A SIGINT, SIGTERM or SIGHUP to the hook, or a failing
#     test stage, stops the build's process group before the hook exits, so no
#     build is left running.
#   * The browser smoke tier runs LAST, sharded: `pnpm test:e2e:sharded` runs N
#     Playwright processes at once (scripts/e2e-sharded.sh, ADR-0017).
#
# The browser smoke tier (added 2026-09-13) comes after the build because it needs
# the build, and it is the one stage that does not run in the toolbox:
# the ts-dev container has no Chromium and cannot be given one (eleven shared
# libraries missing, no sudo). It therefore runs on the HOST, straight out of
# node_modules, against `~/.cache/ms-playwright`. A push from inside the
# toolbox fails here BY DESIGN, with the sentence that says so; it is never
# skipped, because a stage that skips itself when the browser is missing is a
# stage that is always missing.
#
# The integration project joined the gate 2026-08-28 (M163/04). It is the only
# place a COMPOSITION ROOT is exercised, the real actions, over real HTTP,
# against a protocol-faithful fake, and until it ran here, deleting the sync
# that carries a research pin to an account's other devices left every gate
# green. It costs about 4.5 s of a ~33 s gate (measured, 2026-08-28).
#
# Escape hatch (use deliberately, it pushes unverified code):
#   SKIP_TESTS=1 git push        skip the whole gate
set -e

if [ "${SKIP_TESTS:-0}" = "1" ]; then
  echo "⚠ pre-push: gate SKIPPED explicitly (SKIP_TESTS=1)"
  exit 0
fi

# Branch/tag deletions push no content, nothing to test. stdin gives one line
# per ref: "<local_ref> <local_sha> <remote_ref> <remote_sha>"; an all-zero
# local_sha means "delete this remote ref".
has_content=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    '' | *[!0]*) has_content=1 ;;
  esac
done
if [ "$has_content" = "0" ]; then
  echo "▶ pre-push: deletion-only push, no tests to run"
  exit 0
fi

# Where the TS commands run. Inside a container they run bare. Where a toolbox
# with a container named ts-dev exists they run in it, as they always have: the
# maintainer's host lacks native build tools. A host with toolbox but no ts-dev
# (a stock Fedora Silverblue, say) is a contributor's host like any other.
# Anywhere else they run with the node and pnpm on PATH, so a contributor needs
# only Node, pnpm and make to push (M269 spec 08). .githooks/test-no-toolbox.sh
# at the repository root proves that path.
# RUN_PREFIX is the command words in front of a TS command. `run` uses it, and
# so does the background build, which must be started as an external command
# (a shell function cannot be put in its own process group).
if [ -f /run/.containerenv ] || [ -f /.dockerenv ]; then
  RUN_PREFIX="env CI=true"
elif command -v toolbox >/dev/null 2>&1 \
  && toolbox list -c 2>/dev/null | awk 'NR > 1 && $2 == "ts-dev" { found = 1 } END { exit !found }'; then
  RUN_PREFIX="toolbox run -c ts-dev env CI=true"
else
  for tool in node pnpm; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "✖ pre-push: $tool is not on PATH. The gate needs Node 24 or newer and pnpm 11."
      exit 1
    fi
  done
  RUN_PREFIX="env CI=true"
fi
run() { $RUN_PREFIX "$@"; }

# ── FIRST STAGE: can Chromium start at all? ────────────────────────────────
# The browser smoke tier is the last stage and is REQUIRED, so a host that
# cannot start a browser is known to fail before anything slow runs. Checking
# here makes it fail in seconds. This is a REAL LAUNCH, not a path check: the
# toolbox has the browser bytes on a shared cache and still cannot start them,
# which is the case this has to catch. Deliberately NOT wrapped in `run`:
# Chromium cannot start inside the ts-dev toolbox, so the check, like the tier,
# executes on the host with `pnpm` and `node` from the host PATH.
if ! pnpm exec node -e "const {chromium}=require('@playwright/test');chromium.launch().then((b)=>b.close()).then(()=>process.exit(0),()=>process.exit(1))" >/dev/null 2>&1; then
  echo "✖ pre-push: Chromium will not start here, and the browser tier is a REQUIRED gate."
  echo "  Install it in apps/app with: pnpm exec playwright install chromium"
  echo "  On Linux, 'pnpm exec playwright install --with-deps chromium' also installs its system libraries."
  echo "  Inside the ts-dev toolbox it never starts: push from the host shell instead."
  exit 1
fi

# ── FIRST TIER: the documentation manifest ──────────────────────────────────
# No network, no node, no install: POSIX shell over the README's `##
# Documentation` table and the `docs/` directory. It is first because it is the
# cheapest, and because openplate.de reads that table as its manifest, a broken
# row here fails a workflow in another repository, hours later, with nobody
# watching. M193 spec 05.
echo "▶ pre-push: the README Documentation table against docs/"
./scripts/check-docs-manifest.sh

# ── QUADLET UNITS: generated, never hand-edited ─────────────────────────────
# docker/quadlet/<scenario>/ is what podlet writes from the compose files.
# This regenerates every scenario into a temp dir and diffs it against the
# committed copy, so a compose edit without `scripts/quadlet.sh generate`, or a
# unit somebody touched by hand, stops here. podlet is a HOST tool (Homebrew),
# not a toolbox one, like the browser tier; the script says how to install it.
# M231 spec 02.
# Since M262 the units and compose files live in the repository root docker/,
# not apps/app/docker/ (the self-host URLs on raw.githubusercontent point
# there). scripts/quadlet.sh reads ../../docker by running from the root; this
# line stays as it was, because the script finds the root from its own path.
echo "▶ pre-push: the quadlet units against a fresh podlet run"
./scripts/quadlet.sh check

# ── SECOND TIER: the changelog the release page is built from ───────────────
# One test file, about a third of a second. The GitHub Release page's body is
# generated from CHANGELOG.md by `scripts/release-notes.ts`, which refuses a
# bullet with no bold lead, a bullet above every group heading, and an unknown
# group. Without this stage that refusal lands at TAG TIME, when the release is
# already being published and the only fix is a second push. Here it lands on
# the commit that wrote the bullet. The same file runs again in the unit tier
# below; running it twice costs less than one failed release.
echo "▶ pre-push: the changelog the release page is built from"
run pnpm exec node --import tsx --test tests/unit/release-notes.test.ts

echo "▶ pre-push: lint"
run pnpm lint

echo "▶ pre-push: typecheck"
run pnpm typecheck

# The production build runs in the background while the unit and integration
# tests run. It is started as an external command in a process group of its own
# (setsid), so a signal can stop the build and everything it started, and never
# anything else. Without setsid (macOS, say) the trap stops the build's process
# and its children one by one instead. Its output goes to a temp log, read
# again below. Its stdin is /dev/null: a build never asks a question.
build_pid=
build_log=
build_grouped=0

stop_build_tree() {
  if [ "$build_grouped" = "1" ]; then
    kill -TERM -- "-$1" 2>/dev/null || true
    sleep 1
    kill -KILL -- "-$1" 2>/dev/null || true
  else
    stop_descendants "$1"
  fi
}

stop_descendants() {
  for child in $(pgrep -P "$1" 2>/dev/null); do
    stop_descendants "$child"
  done
  kill -TERM "$1" 2>/dev/null || true
}

# Runs on EVERY exit of the hook: a signal (the INT, TERM and HUP traps below
# turn into an exit), a failing stage under `set -e`, or the normal end. While
# build_pid is set the build was never waited for, so it is stopped here.
stop_build() {
  if [ -n "$build_pid" ]; then
    echo "pre-push: stopping the background build"
    stop_build_tree "$build_pid"
    wait "$build_pid" 2>/dev/null || true
    build_pid=
  fi
  if [ -n "$build_log" ]; then
    rm -f "$build_log"
    build_log=
  fi
}
trap stop_build EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

echo "▶ pre-push: production build started in the background (react-router build, the Argo image runs this)"
build_log=$(mktemp "${TMPDIR:-/tmp}/pre-push-build.XXXXXX")
if command -v setsid >/dev/null 2>&1; then
  build_grouped=1
  setsid $RUN_PREFIX pnpm build </dev/null >"$build_log" 2>&1 &
else
  $RUN_PREFIX pnpm build </dev/null >"$build_log" 2>&1 &
fi
build_pid=$!

echo "▶ pre-push: unit tests"
run pnpm test:unit

echo "▶ pre-push: integration tests"
run pnpm test:integration

echo "▶ pre-push: waiting for the production build"
build_rc=0
wait "$build_pid" || build_rc=$?
build_pid=
if [ "$build_rc" != "0" ]; then
  echo "✖ pre-push: the production build failed (exit $build_rc). Its full log:"
  cat "$build_log"
  exit "$build_rc"
fi
echo "pre-push: the production build passed. The last lines of its log:"
tail -n 15 "$build_log"

# ── LAST TIER: the specs in a real browser, against the build above ─────────
# Not wrapped in `run`: Chromium cannot start inside the ts-dev toolbox, so this
# stage must execute on the host (the launch check at the top says so before
# anything slow runs). It is sharded: `pnpm test:e2e:sharded` runs N Playwright
# processes at once, N = OPENPLATE_E2E_SHARDS, else min(4, cores / 4).
#
# TWO PEOPLE CAN PUSH AT ONCE. This stage used to bind three literal ports that
# every checkout on a host shared, so a second push collided here, on the last
# and most expensive stage, and hung. The three ports are now derived from the
# checkout's own path (`tests/e2e/env.ts`, ADR-0017) and printed by every run;
# `scripts/repro-e2e-port-collision.sh` proves two trees pass concurrently. Each
# shard takes three ports of its own from that base.
echo "▶ pre-push: browser smoke tier (host only, sharded, the toolbox has no Chromium)"
CI=true pnpm test:e2e:sharded

echo "✅ pre-push: all gates passed"
