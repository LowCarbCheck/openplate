# This Dockerfile builds the app from tracked source and nothing else, no
# build secret, no private npmrc, no extra clone stage. Every dependency
# resolves from public npm, so anyone can build the published image from a
# plain checkout, and so can the release workflow.
#
# M117/06 briefly complicated that: the E2EE sync engine lived in a separate
# private repo and had to be copied into a gitignored `app/lib/sync/engine/`
# by a manual step before `docker build` ran. M128 spec 01 deleted that seam,
# the engine is ordinary tracked source now, and the sync SERVER is a
# separate deployable with its own image. There is deliberately nothing
# sync-specific left in this file.
FROM node:22-alpine AS dependencies-env
# pnpm comes from corepack, which reads the `packageManager` field of
# package.json and installs exactly that version. So this file carries no
# pnpm version of its own. A global pnpm from npm that is newer than
# `packageManager` downloads the declared version as a separate self-managed
# binary, and that binary has no musl build for arm64, so it segfaulted on
# arm64 alpine before printing anything (2026-08-06 to 2026-08-18). Corepack
# installs the declared version itself, so no second binary is fetched. See
# tests/unit/dockerfile-pnpm-pin.test.ts.
#
# WORKDIR and package.json come BEFORE corepack: without them corepack finds
# no `packageManager` field and falls back to a default version of its own.
WORKDIR /app
COPY ./package.json /app/
RUN corepack enable && corepack prepare --activate
COPY . /app

FROM dependencies-env AS development-dependencies-env
COPY ./package.json pnpm-lock.yaml /app/
WORKDIR /app
RUN pnpm i --frozen-lockfile

FROM dependencies-env AS production-dependencies-env
COPY ./package.json pnpm-lock.yaml /app/
WORKDIR /app
RUN pnpm i --prod --frozen-lockfile

FROM dependencies-env AS build-env
COPY ./package.json pnpm-lock.yaml /app/
COPY --from=development-dependencies-env /app/node_modules /app/node_modules
WORKDIR /app

# The commit this image is built from, stamped into the bundle and reported by
# the `X-Openplate-Build` header. It has to be passed in: `.dockerignore`
# excludes `.git` and the alpine base carries no git binary, so the build cannot
# work it out for itself. Unset is fine, the stamp then says `unknown` and the
# app simply never claims a newer bundle is ready.
ARG OPENPLATE_BUILD_SHA=""
ENV OPENPLATE_BUILD_SHA=$OPENPLATE_BUILD_SHA
RUN pnpm build

FROM dependencies-env
ENV NODE_ENV=production
COPY ./package.json pnpm-lock.yaml /app/
COPY --from=production-dependencies-env /app/node_modules /app/node_modules
COPY --from=build-env /app/build /app/build
WORKDIR /app
CMD ["sh", "scripts/start.sh"]