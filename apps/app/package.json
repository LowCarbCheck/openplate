    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "1.86.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.12"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production react-router build",
    "dev": "tsx ./server.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix --max-warnings 0",
    "release-catalog": "tsx ./scripts/sync-release-catalog.ts",
    "seed:test-account": "tsx ./scripts/seed-test-account.ts",
    "start": "cross-env NODE_ENV=production tsx ./server.ts",
    "sync:brand": "tsx ./scripts/sync-brand.ts",
    "sync:translate-lib": "tsx ./scripts/sync-translate-lib.ts",
    "test:e2e": "playwright test",
    "test:e2e:scoped": "bash scripts/e2e-scoped.sh",
    "test:e2e:select": "node --import tsx scripts/e2e-select.ts",
    "test:e2e:sharded": "bash scripts/e2e-sharded.sh",
    "test:integration": "node --import tsx --test --test-concurrency=1 'tests/integration/**/*.test.ts'",
    "test:unit": "node --import tsx --test 'tests/unit/**/*.test.ts' 'tests/unit/**/*.test.tsx'",
    "translate:ui": "tsx ./scripts/translate-ui.ts",
    "typecheck": "react-router typegen && tsc",
    "vision:export-contract": "tsx ./scripts/export-vision-contract.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.1",
  "description": "Open-source food tracker with BYOK AI plate identity"
}
