#!/usr/bin/env bash
# Root pre-push dispatcher. The local pre-push hook is the ONLY test gate in
# this repository; there is no cloud CI. M262 spec 05.
#
# Git runs hooks only from the root core.hooksPath (`.githooks`, set by
# `make hooks`), so the gates the three apps carry in apps/<x>/.githooks/pre-push
# never run on their own. This file runs them. It decides nothing about HOW an
# app is tested: each app's own hook stays the unit of truth, with its own
# stages in its own order, run from inside apps/<x> so that it reads its own
# lockfile, pnpm-workspace.yaml and tsconfig.json.
#
# What it decides is WHICH apps run:
#   * a path under apps/app/, apps/core/ or apps/inference/
#     runs that app's gate;
#   * any other path (root files, .github/, .githooks/, packages/, docker/, a
#     new folder under apps/) runs ALL three gates, because it can affect any
#     of them. docker/ holds the app's compose files and quadlet units since
#     M262, so the app gate is always among the three it runs.
#   * a release tag (v*, core-v*, inference-v*) runs the gate of the app it
#     names (app, core, inference) whatever its range changed, because a tag
#     usually points at a commit origin already holds and its range is empty;
#   * an app with no changed path is skipped, and the skip is logged by name.
#   * when the range cannot be computed (no origin/main, a remote sha this
#     clone does not have), it runs all three and says why. Guessing "nothing
#     changed" would push untested code with a green hook.
#
# The pushed range, per stdin line "<local_ref> <local_sha> <remote_ref>
# <remote_sha>":
#   * all-zero local_sha: a deletion, nothing to test;
#   * all-zero remote_sha: a new branch or tag, diffed from its merge-base
#     with origin/main;
#   * otherwise: git diff --name-only <remote_sha> <local_sha>.
# Stdin is read ONCE and replayed to every app hook, which reads it again for
# its own deletion-only check.
#
# ONE FULL GATE AT A TIME. A gate is minutes of unit tests, a production build
# and a browser tier, and two of them at once on one host starve each other:
# every timing in the browser tier gets worse, and a gate that fails for load is
# a gate nobody trusts. So once the push is known to test something (the
# SKIP_TESTS and deletion-only exits come first, they take no lock), this
# takes an exclusive flock on /tmp/openplate-gate.lock, held until the hook
# exits and released by the kernel on ANY exit, a kill included. When it is
# held by another gate it says so in one line, names the holder when the lock
# file says who it is, and waits up to an hour. The lock file is NOT
# /tmp/openplate-e2e.lock: that one is taken by hand around single Playwright
# runs, and the two must not be confused.
#   * Without `flock` (macOS, a bare contributor host) it says so in one line
#     and goes on. A push is never failed for a missing lock tool, and never for
#     a lock that cannot be opened or was not freed within the hour: those say
#     so and the gate runs unguarded.
#   * The app hooks run with that file descriptor CLOSED, so a stray child that
#     outlives a hook cannot keep the lock after the dispatcher exits.
#   * `make check` runs an app hook directly and takes no lock.
#
# TWO BROWSER TIERS. The push gate runs the browser tier SCOPED to what the
# push changed; a release tag push (v*, core-v*, inference-v*) and the nightly
# run the FULL tier. This hook only reports the facts to the app hook, as
# environment variables:
#   OPENPLATE_PUSH_TAG=1       exported when any pushed ref is a release tag;
#   OPENPLATE_PUSH_RANGE=a..b  exported when the push has exactly one content
#                              ref and its base is known (the remote sha, or
#                              the merge-base with origin/main for a new ref).
# Otherwise the range is not exported and the scoped runner runs everything.
# OPENPLATE_E2E_FULL=1 git push forces the full tier on any push.
# The gate starts with one status line from the last nightly run, read from
# ${XDG_STATE_HOME:-~/.local/state}/openplate/nightly-e2e/latest.txt. Red does
# not block the push. OPENPLATE_NIGHTLY_STATUS names another file (test seam).
#
# Test seams: GIT_DIFF_OVERRIDE, a newline-separated path list used instead of
# git diff; the stdin lines still decide whether the push is deletion-only.
# OPENPLATE_GATE_LOCK and OPENPLATE_GATE_LOCK_WAIT_SECONDS name another lock
# file and a shorter wait, so a test never queues behind a real gate.
# .githooks/test-dispatch.sh proves the app selection and the lock in a scratch
# repo.
#
# Escape hatch (use deliberately, it pushes unverified code):
#   SKIP_TESTS=1 git push        skip the whole gate
set -euo pipefail

if [ "${SKIP_TESTS:-0}" = "1" ]; then
  echo "⚠ pre-push: gate SKIPPED explicitly (SKIP_TESTS=1)"
  exit 0
fi

APPS=(app core inference)
ZERO_SHA_PATTERN='^0+$'

toplevel=$(git rev-parse --show-toplevel)
apps_root=$toplevel/apps

# In a linked worktree git exports GIT_DIR, and a git command run with GIT_DIR
# but no GIT_WORK_TREE takes its CURRENT DIRECTORY as the top of the working
# tree. Every app hook runs from apps/<x>, so without this its `git status`
# saw the whole tree as deleted and untracked.
# Pin both to absolute values before the first cd.
if [ -n "${GIT_DIR:-}" ]; then
  GIT_DIR=$(git rev-parse --absolute-git-dir)
  GIT_WORK_TREE=$toplevel
  export GIT_DIR GIT_WORK_TREE
fi

stdin_lines=$(cat)

has_content=0
run_all_reason=""
changed=""
content_refs=0
push_tag=0
tag_apps=()
range_base=""
range_head=""
while read -r local_ref local_sha _remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  if [[ $local_sha =~ $ZERO_SHA_PATTERN ]]; then
    continue
  fi
  has_content=1
  # What the app hook needs to choose a browser tier, see the header.
  case "$local_ref" in
    refs/tags/v* | refs/tags/core-v* | refs/tags/inference-v*) push_tag=1 ;;
  esac
  # The app a release tag names, for the rule after the path scan below.
  case "$local_ref" in
    refs/tags/v*) tag_apps+=(app) ;;
    refs/tags/core-v*) tag_apps+=(core) ;;
    refs/tags/inference-v*) tag_apps+=(inference) ;;
  esac
  content_refs=$((content_refs + 1))
  range_head=$local_sha
  range_base=""
  if [[ ${remote_sha:-0} =~ $ZERO_SHA_PATTERN ]]; then
    range_base=$(git merge-base refs/remotes/origin/main "$local_sha" 2>/dev/null) || range_base=""
  elif git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    range_base=$remote_sha
  fi
  [ -z "${GIT_DIFF_OVERRIDE:-}" ] || continue
  [ -z "$run_all_reason" ] || continue

  if [[ ${remote_sha:-0} =~ $ZERO_SHA_PATTERN ]]; then
    if ! base=$(git merge-base refs/remotes/origin/main "$local_sha" 2>/dev/null); then
      run_all_reason="no merge-base between origin/main and $local_sha"
      continue
    fi
  elif git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    base=$remote_sha
  else
    run_all_reason="the remote sha $remote_sha is not in this clone"
    continue
  fi
  changed+=$(git diff --name-only "$base" "$local_sha")$'\n'
done <<<"$stdin_lines"

if [ "$has_content" = "0" ]; then
  echo "▶ pre-push: deletion-only push, no tests to run"
  exit 0
fi

# The last nightly run of the full browser tier, as information only. A red
# nightly never blocks a push: the push gate has its own verdict.
nightly_file=${OPENPLATE_NIGHTLY_STATUS:-${XDG_STATE_HOME:-$HOME/.local/state}/openplate/nightly-e2e/latest.txt}
if [ -s "$nightly_file" ]; then
  read -r nightly_line <"$nightly_file" || true
  echo "pre-push: nightly browser tier: $nightly_line"
else
  echo "pre-push: nightly browser tier: no run recorded yet (make nightly)"
fi

# ── ONE FULL GATE AT A TIME ─────────────────────────────────────────────────
# After the two exits above, so a push that tests nothing never waits for one
# that does. See the header for what each outcome means.
GATE_LOCK_FILE=${OPENPLATE_GATE_LOCK:-/tmp/openplate-gate.lock}
GATE_LOCK_WAIT_SECONDS=${OPENPLATE_GATE_LOCK_WAIT_SECONDS:-3600}

take_gate_lock() {
  local holder="" branch started
  if ! command -v flock >/dev/null 2>&1; then
    echo "▪ pre-push: flock is not installed, the one-gate-at-a-time lock is skipped"
    return 0
  fi
  # Created with mode 666 when it is new, so another account on a shared host
  # can open it too. A host that still refuses (a sticky /tmp that protects
  # regular files, say) is a host where the lock cannot work, not a failed push.
  if ! (umask 0 && : >>"$GATE_LOCK_FILE") 2>/dev/null; then
    echo "▪ pre-push: $GATE_LOCK_FILE cannot be opened, the one-gate-at-a-time lock is skipped"
    return 0
  fi
  # `>>` and not `>`: opening for write would empty the file, and with it the
  # note a gate that holds the lock keeps there, before this one knows whether
  # it may have the lock.
  exec 9>>"$GATE_LOCK_FILE"
  if ! flock -n 9; then
    read -r holder <"$GATE_LOCK_FILE" || true
    echo "▪ pre-push: another gate holds $GATE_LOCK_FILE${holder:+ ($holder)}, waiting up to ${GATE_LOCK_WAIT_SECONDS}s for it"
    started=$SECONDS
    if ! flock -w "$GATE_LOCK_WAIT_SECONDS" 9; then
      echo "⚠ pre-push: the lock was still held after ${GATE_LOCK_WAIT_SECONDS}s, running this gate without it"
      exec 9>&-
      return 0
    fi
    echo "▪ pre-push: got the gate lock after waiting $((SECONDS - started))s"
  fi
  branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown branch")
  printf 'branch %s at %s, pid %s\n' "$branch" "$toplevel" "$$" >"$GATE_LOCK_FILE"
}

take_gate_lock

# ── what the browser tier will be told ──────────────────────────────────────
# Exported for the app hook. A release tag asks for the full tier. A range is
# exported only for ONE content ref with a computable base: with two refs a
# single range would describe the wrong code, so the scoped runner gets no
# range and falls back to the full tier. Unset here, so a value from the
# caller's shell never steers the hook.
unset OPENPLATE_PUSH_TAG OPENPLATE_PUSH_RANGE
if [ "$push_tag" = "1" ]; then
  export OPENPLATE_PUSH_TAG=1
fi
if [ "$content_refs" = "1" ] && [ -n "$range_base" ]; then
  export OPENPLATE_PUSH_RANGE="$range_base..$range_head"
fi

if [ -n "${GIT_DIFF_OVERRIDE:-}" ]; then
  echo "⚠ pre-push: GIT_DIFF_OVERRIDE is set, using its path list instead of git diff"
  changed=$GIT_DIFF_OVERRIDE
fi

declare -A touched=()
mark_all() {
  local app
  for app in "${APPS[@]}"; do touched[$app]=1; done
}

if [ -n "$run_all_reason" ]; then
  echo "⚠ pre-push: cannot compute the pushed range ($run_all_reason), running every app gate"
  mark_all
else
  outside=""
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in
      apps/app/*) touched[app]=1 ;;
      apps/core/*) touched[core]=1 ;;
      apps/inference/*) touched[inference]=1 ;;
      *) outside=${outside:-$path} ;;
    esac
  done <<<"$changed"
  if [ -n "$outside" ]; then
    echo "▶ pre-push: $outside is outside the three apps, running every app gate"
    mark_all
  fi
fi

# A RELEASE TAG ALWAYS RUNS THE GATE OF THE APP IT NAMES. The path scan above
# reads the range a push carries, and a tag usually points at a commit
# origin/main already holds: its range is empty, so without this rule a tag push
# would run no gate at all, and "the release gate runs before the tag leaves the
# machine" (CLAUDE.md) would be a sentence and not a fact. core-v* names core,
# and core's gate carries the integration tier, the photo path guard among it.
for tag_app in "${tag_apps[@]}"; do
  if [ -z "${touched[$tag_app]:-}" ]; then
    echo "▶ pre-push: a release tag names apps/$tag_app, running its gate whatever the range changed"
  fi
  touched[$tag_app]=1
done

for app in "${APPS[@]}"; do
  if [ -z "${touched[$app]:-}" ]; then
    echo "▷ pre-push: apps/$app skipped, no changed path under apps/$app/"
    continue
  fi
  hook="$apps_root/$app/.githooks/pre-push"
  if [ ! -x "$hook" ]; then
    echo "✖ pre-push: apps/$app is touched but $hook is missing or not executable"
    exit 1
  fi
  echo "▶ pre-push: apps/$app gate"
  status=0
  # 9>&-: the hook and everything it starts run without the gate lock's file
  # descriptor, so only this process can be what holds the lock.
  (cd "$apps_root/$app" && ./.githooks/pre-push) 9>&- <<<"$stdin_lines" || status=$?
  if [ "$status" != "0" ]; then
    echo "✖ pre-push: apps/$app gate failed with exit $status, the gates after it did not run"
    exit "$status"
  fi
done

echo "✅ pre-push: every touched app gate passed"
