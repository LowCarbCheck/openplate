[Unit]
Requires=inference.service
After=inference.service

[Container]
EnvironmentFile=app.defaults.env
EnvironmentFile=app.env
HealthCmd=wget -q -O /dev/null http://127.0.0.1:3000/healthcheck
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s
HealthTimeout=5s
Notify=healthy
Image=ghcr.io/lowcarbcheck/openplate:latest
Network=openplate-full.network:alias=app
PublishPort=3000:3000

[Service]
TimeoutStartSec=300
Restart=always

[Install]
WantedBy=default.target
