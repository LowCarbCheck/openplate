# GENERATED by scripts/quadlet.sh from docker/topologies/compose.full.yml with podlet 0.3.2.
# Do not edit by hand: change the compose file, run
# `scripts/quadlet.sh generate`, and commit the result.

[Unit]
Requires=inference.service
After=inference.service

[Container]
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=APP_URL=http://localhost:3000
Environment=SYNC_SERVER_URL=http://localhost:3001
Environment=DEFAULT_INFERENCE_BASE_URL=http://openplate.example.lan:8300/v1
Environment=DEFAULT_INFERENCE_API_KEY=opk_CHANGE_ME
Environment=DEFAULT_INFERENCE_MODEL=openplate-plate-1
Environment=TRUST_PROXY=1
Environment=FOOD_DB_API_URL=https://lowcarbcheck.org
Environment=LOG_LEVEL=info
HealthCmd=["node","-e","fetch('http://127.0.0.1:3000/healthcheck').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s
HealthTimeout=5s
Notify=healthy
Image=ghcr.io/lowcarbcheck/openplate:latest
Network=openplate-full.network
PublishPort=3000:3000

[Service]
Restart=always

[Install]
WantedBy=default.target
